{
  "info": {
    "_postman_id": "34200a4f-1595-55af-99bb-d28b65a7bab8",
    "name": "Booktor demo en vivo",
    "description": "Tres pedidos para mostrar JWT en la exposición con la tutora Lucía de los datos de demo (tutor@booktor.com). Requiere LIQUIBASE_CONTEXTS=demo y el entorno Booktor local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login de Lucía (tutora)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "const datos = pm.response.json();",
              "pm.test(\"Devuelve un token Bearer\", () => pm.expect(datos.tipo).to.eql(\"Bearer\"));",
              "pm.collectionVariables.set(\"token_demo\", datos.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"tutor@booktor.com\",\n  \"password\": \"{{password_prueba}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "2. Mis turnos con el token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Devuelve sus turnos\", () => pm.expect(pm.response.json()).to.not.be.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/turnos/mis-turnos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "turnos",
            "mis-turnos"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_demo}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "3. ABML de tutores con el token de tutora (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tutores",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tutores"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_demo}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "token_demo",
      "value": ""
    }
  ]
}
